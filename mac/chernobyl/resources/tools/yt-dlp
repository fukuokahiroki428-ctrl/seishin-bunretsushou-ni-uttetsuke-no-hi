#!/bin/sh
# ★ .pyc 를 서명된 앱 번들 안에 쓰면 codesign 봉인이 깨져 macOS 가 앱을 죽인다.
#   → 쓰기가능 python_env 를 '먼저' 쓰고, 어떤 경우에도 bytecode 를 남기지 않는다.
# ★ 앱 이름도 데이터 폴더 위치도 여러 번 바뀌었다.
#     이름  : カメラ → Chernobyl → Predormition → Hanishiki
#     위치  : …/Application Support/Miyo/<앱>  →  …/Application Support/<앱>
#   여기에 이름이나 위치를 손으로 적어 두면 그때마다 '앱에서 Python 을 올려도
#   그 환경을 못 쓰는' 고장이 되살아난다(실제로 두 번 겪었다).
#   → 적지 않고 양쪽을 훑는다. 갱신 시각 역순이라 지금 쓰는 것이 먼저 잡힌다.
export PYTHONDONTWRITEBYTECODE=1
# ★ 사용자 쪽 덧씌우기 폴더를 '먼저' 읽는다.
#   번들 python_env 에 직접 설치하면 codesign 봉인이 깨진다. 그래서 자동 갱신은
#   여기에 새 판을 깔고, 이 줄이 그것을 번들보다 앞에 세운다.
#   앱을 거치지 않고 이 스크립트를 직접 불러도 같은 판이 쓰이도록 여기에도 둔다.
for _OV in "$HOME/Library/Application Support"/*/pypkgs; do
  [ -d "$_OV" ] && PYTHONPATH="$_OV${PYTHONPATH:+:$PYTHONPATH}"
done
export PYTHONPATH
DIR="$(cd "$(dirname "$0")" && pwd)"

SUP="$HOME/Library/Application Support"
# 새 위치(조직 폴더 없음) 와 옛 위치(Miyo/ 밑) 를 모두 후보로.
for D in $(ls -1dt "$SUP"/*/ "$SUP"/Miyo/*/ 2>/dev/null); do
  for E in python_env_arm64 python_env; do
    P="$D$E/bin/python3"
    [ -x "$P" ] && exec "$P" -m yt_dlp "$@"
  done
done

for P in \
  "$DIR/../Resources/python_env/bin/python3" \
  "$DIR/../python_env/bin/python3"; do
  [ -x "$P" ] && exec "$P" -m yt_dlp "$@"
done

# ★ 이 껍데기는 사용자 도구 폴더로 '복사되어' 쓰이기도 한다(자가복구가 그렇게 한다).
#   그 자리에서는 위의 상대 경로가 아무 데도 안 맞아, 아래 마지막 줄의 시스템 파이썬
#   으로 떨어졌다 — 그러면 "No module named yt_dlp" 로 죽는다.
#   실측으로 걸린 자리다: 자가진단이 [OK] 로 통과한 직후 같은 도구가 code 1 로 실패했다.
#   설치된 앱 번들을 직접 찾아 그 안의 파이썬을 쓴다.
for A in \
  /Applications/*.app "$HOME/Applications"/*.app; do
  P="$A/Contents/Resources/python_env/bin/python3"
  [ -x "$P" ] && [ -d "$A/Contents/Resources/tools" ] && exec "$P" -m yt_dlp "$@"
done
exec python3 -m yt_dlp "$@"
