# 빌드 산출물
build/
build_*/
dist/
*.o
*.obj

# 대용량 외부 도구 (빌드 시 다운로드/번들)
**/resources/tools/yt-dlp*
**/resources/tools/ffmpeg*
**/resources/tools/ffprobe*
# ★ 단, tools/yt-dlp 는 이제 바이너리가 아니라 1.3K 셸 래퍼(우리가 쓴 소스)다.
#   위 규칙이 바이너리를 막으려고 yt-dlp* 로 넓게 잡는 바람에 이 스크립트까지
#   따라 걸려서, 고쳐도 저장소에 안 남고 다음 사람 손에 옛것이 갔다.
#   이름이 정확히 yt-dlp 인 것만 되살린다(yt-dlp.exe 등 바이너리는 계속 무시).
!**/resources/tools/yt-dlp
**/resources/tools/deno*
**/resources/tools/rclone*
**/resources/tools/exiftool/
**/resources/tools/exiftool.exe
**/resources/chromium/
**/python_env/
**/python_embed/
**/python_standalone/

# 배포 바이너리 (→ GitHub Releases)
*.dmg
*.app
*.exe

# 시스템/IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.user
moc_*.cpp
qrc_*.cpp
ui_*.h

# 대용량 아트(이전 앱에서 가져옴 — 빌드 시 로컬에 위치)
mac/Chernobyl.png
mac/chernobyl/build-univ/

# 비밀정보 — 토큰·키는 절대 저장소에 올리지 않는다.
# 실수로 파일을 만들어도 커밋되지 않도록 미리 막아 둔다.
.env
.env.*
*.token
secrets.*
**/discord_token*
__pycache__/
