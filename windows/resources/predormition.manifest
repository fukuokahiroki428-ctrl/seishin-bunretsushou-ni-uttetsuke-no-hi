<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  ★ 이 매니페스트가 하는 일은 하나다 — "이 앱은 260자 넘는 경로를 다룰 줄 안다" 고
    윈도우에 선언하는 것.

  재 보고 넣었다(2026-09-13, 이 PC: 윈도우 11, LongPathsEnabled=0):
    · Qt 6.7.3 의 QFile/QDir/QFileInfo 는 내부에서 \\?\ 를 붙인다 — 349자 경로에서
      mkpath·열기·훑기·개명·삭제가 NTFS(D:)와 exFAT(F:) 양쪽 다 통과했다.
    · 같은 자리에서 접두사 없는 Win32 CreateDirectoryW 는 ERROR_PATH_NOT_FOUND 로 죽는다.
    · exiftool·ffmpeg·rclone·deno 도 342자 경로를 그대로 통과한다.
    · 통과 못 하는 것은 파이썬 하나뿐이다. 그쪽은 코드에서 \\?\ 를 붙여 푼다
      (Common::longPathArg / 파이썬 도구의 _lp()).

  그러니 정직하게 적어 둔다 — 이 선언만으로 당장 고쳐지는 것은 없다.
  효력을 가지려면 레지스트리도 함께 켜져 있어야 한다:
      HKLM\SYSTEM\CurrentControlSet\Control\FileSystem\LongPathsEnabled = 1  (관리자 권한)
  그건 기계 전체에 영향을 주는 설정이라 사용자가 직접 켜는 몫이다. 이 선언은
  그날 앱이 준비돼 있게 하는 것이고, 우리 코드가 직접 부르는 Win32 호출에도 적용된다.

  구성은 발명하지 않았다 — 이 PC 의 python.exe 가 쓰는 선언을 그대로 본떴다.
  파이썬은 긴 경로를 실제로 지원하는 프로그램이라, 검증된 배치를 베끼는 편이
  내가 지어낸 최소 구성보다 안전하다.
  ※ dpiAware 는 일부러 넣지 않는다 — 매니페스트에 적으면 Qt 가 실행 중에 거는
    Per-Monitor v2 설정을 덮어써서 고해상도 화면에서 UI 가 흐려진다.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <!-- 관리자 권한을 요구하지 않는다. MSVC 링커의 기본값과 같다. -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows Vista -->
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}"/>
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>

</assembly>